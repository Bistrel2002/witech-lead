# ==========================================
# WITECH LEAD ENVIRONMENT CONFIGURATIONS
# ==========================================

# 1. API Ports & Environment
PORT=3001
NODE_ENV=development

# 2. Main CRM Database Configuration
# Leave blank to fallback to local database.sqlite
DATABASE_URL=postgresql://crm_admin:crm_secure_password@localhost:5432/witech_crm

# 3. External French Business Database (Read-Only)
# Keeps CRM database lightweight (<2GB). Can point to external schema.
FRENCH_DB_URL=postgresql://crm_admin:crm_secure_password@localhost:5432/witech_crm

# 4. Platform Outreach Infrastructure (operator-owned, never per-customer)
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Root zone delegated to Route53. Per-tenant subdomains are created beneath it.
MAIL_ROOT_DOMAIN=mail.witechagency.com
# Route53 hosted zone ID for MAIL_ROOT_DOMAIN
ROUTE53_HOSTED_ZONE_ID=
# Optional: SES configuration set used to route bounce/complaint events to SNS
SES_CONFIGURATION_SET=witech-outreach
# Local part of the envelope sender: no-reply@{tenant}.mail.witechagency.com
MAIL_FROM_LOCAL_PART=no-reply

# 5. Shared Twilio account (one platform account, alphanumeric Sender ID)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SENDER_ID=WITECH

# 6. Authentication & JWT Sessions
JWT_SECRET=witech-crm-token-key-2026

# 7. Developer Bypass (Bypass Apple/Google Login locally)
# Set to 'true' to auto-login mock dev credentials
VITE_MOCK_AUTH=true

# 8. Hidden Portals Secret Access Passwords
ADMIN_PORTAL_PASSWORD=admin123
TEAM_PORTAL_PASSWORD=team123

# 9. HashiCorp Vault Connection
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=witech-vault-token
VAULT_SECRET_PATH=witech-crm

# 10. S3-Compatible Storage (AWS S3 or MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=witech-backups
S3_ACCESS_KEY_ID=backup_admin
S3_SECRET_ACCESS_KEY=minio_secure_password
S3_REGION=us-east-1
# FERNET_KEY=  (Leave blank to auto-generate and store in Vault on first backup)
